// Firestore Security Rules for Roadside Assistance App
// Phase 1: Database Security - OPTIMIZED VERSION

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions - OPTIMIZED to reduce get() calls
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // ✅ OPTIMIZED: Use custom claims when available, fallback to document lookup
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == 'admin') ||
        (request.auth.token.role == null && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isDriver() {
      return isAuthenticated() && (
        (request.auth.token.userType == 'driver') ||
        (request.auth.token.userType == null && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'driver')
      );
    }
    
    function isClient() {
      return isAuthenticated() && (
        (request.auth.token.userType == 'client') ||
        (request.auth.token.userType == null && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'client')
      );
    }
    
    // Users collection
    match /users/{userId} {
      // ✅ SIMPLIFIED: Allow authenticated users to read any user (needed for driver info in bids)
      allow read: if isAuthenticated();
      
      // Users can create their own profile during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own data, admins can update anyone
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Orders collection - PRODUCTION RULES with proper ownership checks
    match /orders/{orderId} {
      // Clients can read their own orders, drivers can read orders they're involved in
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.acceptedDriverId == request.auth.uid ||
        resource.data.reservedDriverId == request.auth.uid ||
        isDriver() ||  // Drivers can see available orders to bid on
        isAdmin()
      );

      // Only clients can create orders (their own)
      allow create: if isAuthenticated() &&
        request.resource.data.clientId == request.auth.uid;

      // Clients can update their own orders, accepted drivers can update order status
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.acceptedDriverId == request.auth.uid ||
        resource.data.reservedDriverId == request.auth.uid ||
        isAdmin()
      );

      // Only admins can delete orders
      allow delete: if isAdmin();

      // Bids subcollection (legacy - kept for backwards compatibility)
      match /bids/{bidId} {
        // Anyone authenticated can read bids for orders they have access to
        allow read: if isAuthenticated();

        // Drivers can create bids
        allow create: if isAuthenticated() && isDriver();

        // Drivers can update their own bids, clients can update to accept
        allow update: if isAuthenticated();

        // Only admins can delete bids
        allow delete: if isAdmin();
      }
    }

    // Top-level bids collection (new structure)
    match /bids/{bidId} {
      // Read: involved parties (client of order, driver who made bid)
      allow read: if isAuthenticated();

      // Create: only drivers can create bids
      allow create: if isAuthenticated() &&
        request.resource.data.driverId == request.auth.uid;

      // Update: driver can update their own bid, or anyone involved in the order
      allow update: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      // Delete: only admins
      allow delete: if isAdmin();
    }
    
    // Driver locations collection - PRODUCTION RULES
    match /driverLocations/{driverId} {
      // Anyone can read driver locations (needed for nearby drivers feature)
      allow read: if isAuthenticated();

      // Only the driver themselves can write their location
      allow create, update: if isAuthenticated() &&
        request.auth.uid == driverId;

      // Drivers can delete their own location, admins can delete any
      allow delete: if isAuthenticated() && (
        request.auth.uid == driverId ||
        isAdmin()
      );
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read and manage their own notifications
      allow read, write: if isAuthenticated();
      
      // Allow deletion of own notifications
      allow delete: if isAuthenticated();
    }
    
    // Order analytics collection
    match /orderAnalytics/{analyticsId} {
      allow read, write: if isAuthenticated(); // Simplified for now
    }

    // Webhook events collection (for idempotency - server-side only)
    match /webhookEvents/{eventId} {
      // Only server (admin SDK) can write, users can't access
      allow read, write: if false;
    }

    // Payment links collection (server-side created)
    match /paymentLinks/{linkId} {
      // Clients can read their own payment links
      allow read: if isAuthenticated() &&
        resource.data.clientId == request.auth.uid;

      // Only server can write
      allow write: if false;
    }
    
    // 🔒 NEW: Driver locks collection for atomic locking
    match /driverLocks/{driverId} {
      // Allow authenticated users to read/write locks
      allow read, write: if request.auth != null;
      
      // Allow automatic cleanup of expired locks
      allow delete: if request.auth != null && 
        resource.data.expiresAt < request.time;
        
      // Prevent lock hijacking - only allow updates from same order
      allow update: if request.auth != null && 
        resource.data.orderId == request.resource.data.orderId;
    }
    
    // Default: deny unless explicitly allowed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 