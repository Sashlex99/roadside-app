rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an admin
    // Checks both admins collection AND users collection for role: "admin"
    function isAdmin() {
      return isAuthenticated() && (
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Helper function to check if user is a driver
    function isDriver() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // ADMIN COLLECTION - Admin users list
    // ============================================
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // USERS COLLECTION - Client users
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // DRIVERS COLLECTION
    // ============================================
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(driverId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // DRIVER LOCATIONS - Real-time tracking
    // ============================================
    match /driverLocations/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(driverId) || isAdmin();
    }

    // ============================================
    // ORDERS COLLECTION
    // ============================================
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      // Bids subcollection
      match /bids/{bidId} {
        allow read: if isAuthenticated();
        allow create: if isDriver();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }

    // ============================================
    // SYSTEM HEALTH - Monitoring data
    // ============================================
    match /systemHealth/{document=**} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // ============================================
    // SYSTEM ALERTS - Monitoring alerts
    // ============================================
    match /systemAlerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // REGIONAL CACHES - N+1 optimization
    // ============================================
    match /regionalCaches/{region} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions can write
    }

    // ============================================
    // PUSH TOKENS - Notification tokens
    // ============================================
    match /pushTokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
